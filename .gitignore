__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Jac build output
__jac_gen__/
*.jbc
.jac/

# Captured device snapshots are large and machine-specific; the canonical
# committed one is fixtures/perry.json (checked in deliberately -- it is what
# makes the demo runnable without hardware).
fixtures/*.tar.gz
fixtures/jacos-snapshot/

.env
.DS_Store

# Credentials live outside this repo entirely (see ~/.jacos/SECRETS.md).
# These rules exist only to catch an accidental re-creation in-tree.
SECRETS.md
secrets.md
*.pem
id_*
!id_*.pub.example

# Vendored wheel for offline install on the phone (14 MB binary, not source).
vendor/
